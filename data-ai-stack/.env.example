# =====================================================================
# Data Warehouse (SQL Server / SSIS)
# host.docker.internal = SQL Server instalado en tu Windows (host).
# Para un servidor remoto pon su IP/hostname. Para el SQL Server del
# profile local-dw usa DW_HOST=dw
# =====================================================================
DW_HOST=host.docker.internal
DW_PORT=1433
DW_DATABASE=DataWarehouse
DW_USER=sa
DW_PASSWORD=ChangeMe_Strong1!
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_ENCRYPT=yes
DW_TRUST_SERVER_CERTIFICATE=yes

# =====================================================================
# MLflow
# =====================================================================
MLFLOW_PORT=5000
MLFLOW_WORKERS=2
# Hosts validos para el header Host (MLflow 3 bloquea DNS rebinding). Si abres la UI por IP/hostname de tu LAN, agregalo aqui.
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,mlflow,mlflow:*,host.docker.internal,10.*,172.*,192.168.*
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow

# =====================================================================
# Jupyter
# =====================================================================
JUPYTER_PORT=8888
JUPYTER_TOKEN=changeme

# =====================================================================
# SQL Server local (solo profile local-dw)
# Debe cumplir politica: 8+ chars, mayus, minus, digito, simbolo.
# =====================================================================
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=ChangeMe_Strong1!
